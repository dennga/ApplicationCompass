<?xml version="1.1" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="20261005120000-create-job-application-table" author="dennga">
        <createTable tableName="job_application">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="company_name" type="VARCHAR(200)">
                <constraints nullable="false"/>
            </column>
            <column name="city" type="VARCHAR(100)"/>
            <column name="position" type="VARCHAR(200)">
                <constraints nullable="false"/>
            </column>
            <column name="applied_at" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="contact_person" type="VARCHAR(150)"/>
            <column name="job_url" type="VARCHAR(500)"/>
            <column name="notes" type="TEXT"/>
        </createTable>
    </changeSet>

</databaseChangeLog>